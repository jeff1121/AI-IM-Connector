# =============================================================================
# AI IM Connector — 環境變數設定範本
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env
# =============================================================================

# === 域名設定（Caddy 自動 HTTPS 憑證） ===
DOMAIN=Ai-Assistant.jcome.uk
# Let's Encrypt 憑證註冊 email（憑證到期通知用）
ACME_EMAIL=
# Caddyfile 路徑（掛載至 Caddy 容器）
CADDYFILE_PATH=./Caddyfile

# === LINE Message API ===
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# === Telegram Bot API ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=

# === ACP Server 連線設定 ===
# Copilot CLI Headless 模式位址（容器內透過 host.docker.internal 連線主機）
ACP_CLI_URL=host.docker.internal:10080
# AI 回應逾時秒數
RESPONSE_TIMEOUT=120

# === 連接器公開 URL（供多媒體暫存服務產生下載連結） ===
PUBLIC_BASE_URL=https://your-domain.example.com

# === Agent 綁定設定（每個 IM 平台綁定的 AI 模型） ===
LINE_AGENT_NAME=copilot-cli
LINE_MODEL=gpt-5
# System Prompt — 指示 AI 將圖片以 Base64 嵌入回應（留空則不注入）
LINE_SYSTEM_PROMPT=
TELEGRAM_AGENT_NAME=gemini-cli
TELEGRAM_MODEL=claude-sonnet-4.5
TELEGRAM_SYSTEM_PROMPT=

# === .NET 執行環境 ===
ASPNETCORE_ENVIRONMENT=Production

# === Docker Image 建置與推送 ===
# Azure Container Registry 位址
ACR_REGISTRY=logicalis.azurecr.io
# Image 版本號
IMAGE_VERSION=1.0.0
