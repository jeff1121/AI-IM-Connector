# =============================================================================
# AI IM Connector — 環境變數設定範本
# 複製此檔案為 .env 並填入實際值
# cp .env.example .env
# =============================================================================

# === 域名設定（Caddy 自動 HTTPS 憑證） ===
DOMAIN=Ai-Assistant.jcome.uk

# === LINE Message API ===
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# === Telegram Bot API ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_SECRET_TOKEN=

# === ACP Server 連線設定 ===
# Copilot CLI Headless 模式位址（容器內透過 host.docker.internal 連線主機）
ACP_CLI_URL=host.docker.internal:10080
# AI 回應逾時秒數
RESPONSE_TIMEOUT=120

# === Agent 綁定設定（每個 IM 平台綁定的 AI 模型） ===
LINE_AGENT_NAME=copilot-cli
LINE_MODEL=gpt-5
TELEGRAM_AGENT_NAME=gemini-cli
TELEGRAM_MODEL=claude-sonnet-4.5

# === .NET 執行環境 ===
ASPNETCORE_ENVIRONMENT=Production
